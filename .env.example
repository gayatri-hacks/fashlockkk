# Local-only Ollama image generation worker. Do not expose these in browser code.
IMAGE_ADMIN_SECRET=change_me_for_admin_image_job_requests
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_IMAGE_MODEL=x/flux2-klein:4b
OLLAMA_IMAGE_SIZE=1024x1024
IMAGE_WORKER_ID=fashlock-local-mac
IMAGE_WORKER_POLL_MS=5000
IMAGE_WORKER_TIMEOUT_MS=300000
