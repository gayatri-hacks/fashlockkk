# Scheduled multi-region trend intelligence
MULTI_REGION_TRENDS_ENABLED=false
AI_TREND_REFINEMENT_ENABLED=false
MAX_AI_TRENDS_PER_RUN=8
AUTO_ENQUEUE_TREND_IMAGES_ENABLED=false
TREND_MARKETS=IN,US,GB,FR,IT,JP,KR,AU,BR,AE
TREND_PIPELINE_SECRET=change_me_for_trend_cron_requests
FASHLOCK_PRODUCTION_URL=https://fashlockkk.vercel.app

# Local-only Ollama image generation worker. Do not expose these in browser code.
IMAGE_ADMIN_SECRET=change_me_for_admin_image_job_requests
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_IMAGE_MODEL=x/flux2-klein:4b
OLLAMA_IMAGE_SIZE=1024x1024
IMAGE_WORKER_ID=fashlock-local-mac
IMAGE_WORKER_POLL_MS=5000
IMAGE_WORKER_TIMEOUT_MS=300000
